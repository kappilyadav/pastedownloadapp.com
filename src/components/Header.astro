<script>
  function closeThemeMenus() {
    document.querySelectorAll('[data-theme-menu]').forEach(function(menu) {
      var trigger = menu.querySelector('[data-theme-trigger]');
      var dropdown = menu.querySelector('[data-theme-dropdown]');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.classList.add('hidden');
    });
  }

  function closeNavMenus() {
    document.querySelectorAll('[data-nav-menu]').forEach(function(menu) {
      var trigger = menu.querySelector('[data-nav-trigger]');
      var dropdown = menu.querySelector('[data-nav-dropdown]');
      if (trigger) trigger.setAttribute('aria-expanded', 'false');
      if (dropdown) dropdown.classList.add('hidden');
    });
  }

  document.querySelectorAll('[data-nav-menu]').forEach(function(menu) {
    var trigger = menu.querySelector('[data-nav-trigger]');
    var dropdown = menu.querySelector('[data-nav-dropdown]');

    trigger.addEventListener('click', function() {
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeThemeMenus();
      closeNavMenus();
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        dropdown.classList.remove('hidden');
      }
    });
  });

  document.querySelectorAll('[data-theme-menu]').forEach(function(menu) {
    var trigger = menu.querySelector('[data-theme-trigger]');
    var dropdown = menu.querySelector('[data-theme-dropdown]');

    trigger.addEventListener('click', function() {
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeThemeMenus();
      closeNavMenus();
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        dropdown.classList.remove('hidden');
      }
    });

    menu.querySelectorAll('[data-theme-option]').forEach(function(option) {
      option.addEventListener('click', function() {
        window.__setThemePreference(option.dataset.themeOption);
        closeThemeMenus();
        trigger.focus();
      });
    });
  });

  document.addEventListener('click', function(event) {
    var target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-theme-menu]')) closeThemeMenus();
    if (!(target instanceof Element) || !target.closest('[data-nav-menu]')) closeNavMenus();
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeThemeMenus();
      closeNavMenus();
    }
  });

  window.__syncThemeControls();
</script>

<style>
  [data-theme-menu][data-theme-current="system"] [data-theme-current-icon="light"],
  [data-theme-menu][data-theme-current="system"] [data-theme-current-icon="dark"] {
    opacity: 0;
  }

  [data-theme-menu][data-theme-current="system"] [data-theme-current-icon="system"] {
    opacity: 1;
  }

  [data-theme-option][aria-checked="true"] {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  [data-theme-option][aria-checked="true"] .theme-check {
    opacity: 1;
  }
</style>
