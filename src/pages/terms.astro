---
import ContentLayout from '../layouts/ContentLayout.astro';
---

<ContentLayout title="Terms &amp; Conditions - PasteDownloadApp" description="Terms and Conditions for PasteDownloadApp. Free image downloader tool with client-side processing. Read our terms of service." canonicalUrl="https://pastedownloadapp.com/terms/">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pastedownloadapp.com/" },
        { "@type": "ListItem", "position": 2, "name": "Terms & Conditions", "item": "https://pastedownloadapp.com/terms/" }
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Terms & Conditions - PasteDownloadApp",
      "description": "Terms and Conditions for PasteDownloadApp. Free online image downloader tool.",
      "publisher": {
        "@type": "Organization",
        "name": "PasteDownloadApp"
      }
