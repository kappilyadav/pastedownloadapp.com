        <svg width="16" height="16" class="sm:w-[18px] sm:h-[18px]" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
      <span class="text-xs sm:text-sm font-semibold text-ink tracking-tight">Paste Download</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden sm:flex items-center gap-1.5" aria-label="Main navigation">
      <a href="#paste" class="text-body text-sm px-3 py-1.5 rounded-full hover:bg-canvas-soft-2 transition-colors no-underline focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none">Paste</a>
