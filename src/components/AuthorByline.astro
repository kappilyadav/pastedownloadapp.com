---
export interface Props {
  publishDate: string;
  updatedDate?: string;
  bio?: string;
}

const {
  publishDate,
  updatedDate,
  bio = "Full-stack developer who builds and maintains PasteDownloadApp using the browser's native Clipboard and Canvas APIs. Ships public code on GitHub and tests every guide against real files in the live tool before publishing.",
} = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<div class="mb-6 pb-6 border-b border-hairline not-prose">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-mute text-xs sm:text-sm">
    <a href="/author/" class="flex items-center gap-2.5 text-ink no-underline hover:text-link transition-colors">
      <img
        src="/author-kappil-yadav.webp"
        alt="Kappil Yadav"
        width="36"
        height="36"
        loading="lazy"
        class="w-9 h-9 rounded-full border border-hairline object-cover shrink-0 bg-canvas-soft"
      />
      <span class="flex flex-col leading-tight">
        <span class="font-medium">Written by Kappil Yadav</span>
        <span class="text-[11px] sm:text-xs text-mute font-normal">Full-Stack Developer, PasteDownloadApp</span>
      </span>
    </a>
    <span class="w-full sm:w-auto flex flex-wrap items-center gap-x-3 gap-y-1">
      <span aria-hidden="true" class="hidden sm:inline">&middot;</span>
      <span>Published {formatDate(publishDate)}</span>
      {updatedDate && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>Last updated {formatDate(updatedDate)}</span>
        </>
      )}
    </span>
  </div>
  {bio && (
    <p class="text-mute text-xs sm:text-sm leading-relaxed mt-2.5 mb-0">{bio}</p>
  )}
</div>
