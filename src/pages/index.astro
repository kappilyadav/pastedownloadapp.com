---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PasteZone from '../components/PasteZone.astro';
import UrlDownload from '../components/UrlDownload.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Footer from '../components/Footer.astro';
import { latestArticles } from '../data/articles';
---

<Layout title="Paste Download - Copy Paste Image Downloader" description="Paste image to download from your clipboard, Ctrl+V, drag and drop, or a direct URL. Save copied images, photos, and screenshots as PNG, JPEG, or WebP." canonicalUrl="https://pastedownloadapp.com/">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "@id": "https://pastedownloadapp.com/#webapplication",
      "name": "PasteDownloadApp",
      "url": "https://pastedownloadapp.com/",
      "description": "Free online paste download tool for saving copied images, clipboard photos, screenshots, and direct image URLs as PNG, JPEG, or WebP with private browser-based processing.",
      "applicationCategory": "Multimedia",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I use paste image to download on mobile?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tap the Access Clipboard button to grant permission, then paste your image. On supported mobile browsers, you can also import images from your gallery or file manager. Clipboard image processing happens in your browser, which helps when you need to download an image from clipboard on Android or iOS."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paste an image and convert it to another format?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Paste any image from your clipboard, drag and drop a file, or fetch one from a URL, then download it as PNG, JPEG, or WebP. Conversion is handled locally in your browser using the Canvas API."
          }
        },
        {
          "@type": "Question",
          "name": "Is PasteDownloadApp free?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The tool is free to use with no sign-up, no watermark, no hidden fees, and no usage caps."
          }
        },
        {
          "@type": "Question",
          "name": "Can I paste an image to view it before downloading?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. After you paste an image or fetch one from a URL, the tool displays a preview with details like dimensions and file size. You can inspect the image before choosing a format and downloading."
          }
        },
        {
          "@type": "Question",
          "name": "What does this image downloader do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PasteDownloadApp is a paste downloader for copied images, screenshots, clipboard photos, and direct image URLs. Copy an image, paste it on the website, preview it, and save it in your preferred format."
          }
        },
        {
          "@type": "Question",
          "name": "How do I download a copied image?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Copy an image to your clipboard, visit the tool, paste it with Ctrl+V or Cmd+V, choose a format, and click Download. You can enable Auto-download for faster repeated copy paste download workflows."
          }
        },
        {
          "@type": "Question",
          "name": "How does the browser-based processing work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The tool uses the browser Clipboard API to read image data and the Canvas API for format conversion. Clipboard images are processed on your device. URL downloads are fetched through the browser and converted when possible."
          }
        }
      ]
    }
  </script>
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-ink focus:dark:bg-neutral-800 focus:text-on-primary focus:text-sm focus:rounded-lg focus:no-underline">
    Skip to main content
  </a>

  <Header />

  <main id="main-content" class="mx-auto max-w-[1400px] px-4 sm:px-6">

    <!-- Hero -->
    <section class="relative pt-12 pb-10 sm:pt-20 sm:pb-16 text-center overflow-hidden">
      
      <!-- Tool Cards -->
      {/*
        AdSense safety: do not place ads inside or directly beside the paste/download tools.
        Keep ad units in content sections below this interactive area to reduce accidental-click risk.
      */}
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5 mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24 max-w-8xl mx-auto">
        <PasteZone />
        <UrlDownload />
      </section>

      <div class="relative">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas border border-hairline text-mute text-xs font-medium mb-6">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          Privacy-first &middot; 100% in-browser
        </span>

        <h1 class="text-[32px] sm:text-5xl lg:text-[56px] font-semibold text-ink tracking-[-1.6px] sm:tracking-[-2.4px] leading-[1.1] max-w-[700px] mx-auto text-balance">
          Paste Download Images Instantly
        </h1>
        <p class="text-body text-base sm:text-lg lg:text-xl mt-4 sm:mt-5 max-w-[600px] mx-auto leading-relaxed text-pretty">
          Copy an image, press Ctrl+V, and download it as PNG, JPEG, or WebP. PasteDownloadApp works as a private paste downloader for screenshots, copied photos, clipboard images, drag-and-drop files, and direct image URLs.
        </p>
        <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-8 sm:mt-10" aria-label="Information pages">
            <a href="/about/" class="text-body text-xs sm:text-sm no-underline hover:text-ink transition-colors flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            About
          </a>
          <span class="text-hairline-strong text-xs" aria-hidden="true">/</span>
            <a href="/privacy/" class="text-body text-xs sm:text-sm no-underline hover:text-ink transition-colors flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Privacy
          </a>
          <span class="text-hairline-strong text-xs" aria-hidden="true">/</span>
            <a href="/terms/" class="text-body text-xs sm:text-sm no-underline hover:text-ink transition-colors flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Terms
          </a>
          <span class="text-hairline-strong text-xs" aria-hidden="true">/</span>
            <a href="/contact/" class="text-body text-xs sm:text-sm no-underline hover:text-ink transition-colors flex items-center gap-1.5">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Contact
          </a>
        </nav>
      </div>
    </section>


    <!-- Features -->
    <section class="mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24">
      <Features />
    </section>

    <!-- How It Works -->
    <section class="mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24">
      <HowItWorks />
    </section>
    <!-- SEO Content -->
    <section class="mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24">
      <div class="rounded-xl bg-canvas border border-hairline px-5 sm:px-10 py-8 sm:py-12">
        <h2 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-0 mb-6 leading-tight text-balance">
          Paste Download for Clipboard Images, Photos, and Screenshots
        </h2>

        <div class="text-body text-sm sm:text-[15px] leading-relaxed space-y-4 [&_h3]:text-ink [&_h3]:text-base [&_h3]:sm:text-lg [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:leading-tight [&_a]:text-link [&_a]:underline [&_a]:underline-offset-2 [&_a]:decoration-link/30 [&_a]:transition-colors [&_a:hover]:decoration-link">
          <p>
            Looking for a fast, private, and reliable way to save a copied image as a file? PasteDownloadApp gives you a focused paste download workspace for screenshots, design mockups, charts, photos, and other images that are already on your clipboard. If you want a broader walkthrough, read the guide to <a href="/blog/save-clipboard-image-without-software/">save clipboard images without software</a>. You can preview the image, pick an output format, and download it without sending the file to our servers.
          </p>
          <p>
            The workflow is simple: copy an image, open the tool, and press Ctrl+V or Cmd+V. The browser reads the image data, shows a preview, and lets you save it as PNG, JPEG, or WebP. If you are deciding between formats, compare <a href="/blog/png-vs-jpg-vs-webp/">PNG vs JPG vs WebP</a> before downloading. That means fewer temporary files, fewer trips through image editors, and a faster copy paste download path from copied image to finished file.
          </p>

          <h3>Save Images from Your Clipboard</h3>
          <p>
            Clipboard saving is designed for speed and convenience. Once you paste an image, the tool shows its dimensions and file size so you know exactly what you are saving. Designers, developers, marketers, students, and casual users can all use the same quick process for screenshots, copied photos, UI captures, and reference images. It is useful when you want to paste image to download, paste photo to download, copy image to download, or turn a clipboard capture into a clean image file. Windows users can also follow the guide to <a href="/blog/save-screenshot-as-file-windows/">save screenshots directly as files</a>.
          </p>
          <p>
            If you prefer a hands-free workflow, enable the Auto-download toggle. With this setting turned on, each pasted image saves automatically in your selected format. It is especially useful when you need to copy to download several images in a row, use Ctrl+V to download repeatedly, and keep moving. On macOS, see how to <a href="/blog/download-copied-image-mac/">download a copied image on Mac</a> without routing it through Photos.
          </p>

          <h3>Save Images from a URL</h3>
          <p>
            Not every image you need starts in your clipboard. When you have a direct image link, paste the URL into the input field and click Fetch. The tool retrieves the image, shows a preview, and lets you save it in the format you need. URL downloads support JPEG, PNG, WebP, GIF, SVG, BMP, and ICO formats, so the same page can work as a clipboard downloader and a simple image URL downloader.
          </p>
          <p>
            Some image hosts block direct browser requests. When that happens, the tool can try a fallback fetch path and, if needed, still show the image so you can use your browser's standard "Save Image As" option. The goal is a clear, predictable saving flow without extra software.
          </p>

          <h3>Use It on Mobile</h3>
          <p>
            The tool works on smartphones and tablets too. Mobile browsers handle clipboard access differently from desktop browsers, so use the "Access Clipboard" button when needed. On supported devices, you can also import images from your gallery or file manager and then choose the file format before saving. This helps with paste image to download mobile searches and common tasks like downloading an image from clipboard on Android.
          </p>

          <h3>Why Use a Browser-Based Image Saver?</h3>
          <p>
            If you regularly save images from different sources, a browser-based tool can remove a lot of small interruptions. PasteDownloadApp combines clipboard import, URL fetching, drag and drop, format conversion, and batch-friendly auto-download in one clean interface. Here is why users choose it:
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-body">
            <li><strong>Privacy-first:</strong> Clipboard images are processed in your browser and never uploaded to our servers.</li>
            <li><strong>No sign-ups:</strong> Start saving images immediately with zero registration.</li>
            <li><strong>Format conversion:</strong> Paste to image formats like PNG, JPEG, and WebP before downloading.</li>
            <li><strong>Flexible inputs:</strong> Use clipboard to download, drag and drop image downloader, direct URL, or mobile import workflows.</li>
            <li><strong>Unlimited use:</strong> Download as many images as you want with no caps, no watermarks, and no hidden fees.</li>
            <li><strong>Cross-platform:</strong> Works on Windows, Mac, Linux, Android, and iOS.</li>
          </ul>

          <h3>How the Browser-Based Processing Works</h3>
          <p>
            Clipboard images are handled directly by your browser. We use the Clipboard API to read image data and the Canvas API to convert formats when needed. For URL downloads, the browser fetches the image using standard HTTP requests and converts it when cross-origin rules allow. This approach keeps local clipboard files private while still giving you useful format options.
          </p>
          <p>
            Drag and drop works the same way as clipboard import. You can drag an image file from your file explorer or another browser tab into the paste zone, inspect the preview, and choose a format. The page is built to keep the image-saving task straightforward, whether the file came from your clipboard, a folder, a mobile gallery, or a URL.
          </p>

          <h3>Get Started</h3>
          <p>
            No setup, installation, or account creation is required. Open the tool, paste an image or enter a direct image URL, choose your format, and save the file. Bookmark this page and come back whenever you need a quick way to turn copied images, pasted photos, screenshots, or URL images into downloadable files.
          </p>
          <p class="text-mute text-xs italic mt-6 pt-4 border-t border-hairline">
            Last updated: June 2026. This tool is free to use with no limitations.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24">
      <div class="rounded-xl bg-canvas border border-hairline px-5 sm:px-10 py-8 sm:py-12">
        <h2 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-0 mb-6 leading-tight text-balance">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              How do I use paste image to download on mobile?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">Tap the <strong>Access Clipboard</strong> button to grant permission, then paste your image. On supported mobile browsers, you can also import images from your gallery or file manager. This is helpful when you need to download an image from clipboard on Android or save a copied photo on iOS.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              How do I save a pasted image as JPG?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">After adding your image, select <strong>JPEG (JPG)</strong> from the format dropdown before clicking Download. The browser converts the file with the Canvas API so you can save a clean JPG. For format tradeoffs, read the <a href="/blog/png-vs-jpg-vs-webp/">PNG, JPG, and WebP guide</a>.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              Can I paste an image and convert it to another format?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">Yes. Paste any image from your clipboard or fetch one from a URL, then download it in <strong>PNG</strong>, <strong>JPEG</strong>, or <strong>WebP</strong> format. Conversion happens locally in your browser when supported.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              Is PasteDownloadApp free?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">Yes, completely <strong>free</strong> with unlimited downloads. No sign-ups, no watermarks, no hidden fees, and no usage caps.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              Can I paste an image to view it before downloading?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">Yes. After you paste an image or fetch one from a URL, the tool displays a <strong>preview</strong> with details like dimensions and file size. You can inspect the image before choosing a format and downloading.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              What does this image downloader do?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">PasteDownloadApp is a paste downloader for copied images, screenshots, clipboard photos, and direct image URLs. Copy an image, paste it on the website, preview it, and save it in your preferred format (PNG, JPEG, or WebP).</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              How do I download a copied image?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">Copy an image to your clipboard (<strong>Ctrl+C</strong> on Windows or <strong>Cmd+C</strong> on Mac), visit the tool, paste it (<strong>Ctrl+V</strong> or <strong>Cmd+V</strong>), choose your preferred format, and click Download. For a step-by-step copy paste download workflow, see how to <a href="/blog/save-clipboard-image-without-software/">save clipboard images without software</a>. For repeated saves, enable <strong>Auto-download</strong>.</p>
            </div>
          </details>
          <details class="group rounded-xl border border-hairline bg-[var(--color-bg-canvas)] open:border-link/30 transition-colors">
            <summary class="flex items-center gap-3 px-5 py-4 cursor-pointer text-ink font-medium text-sm sm:text-base list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="shrink-0 w-4 h-4 text-mute transition-transform duration-200 group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              How does the browser-based processing work?
            </summary>
            <div class="px-5 pb-4 pt-0 text-body text-sm sm:text-[15px] leading-relaxed border-t border-hairline mt-0">
              <p class="pt-3">The tool uses the browser's <strong>Clipboard API</strong> to read image data and the <strong>Canvas API</strong> for format conversion. Clipboard images are processed on your device. URL downloads are fetched through the browser and converted when possible.</p>
            </div>
          </details>
        </div>
      </div>
    </section>

    {/*
      Safe AdSense insertion point: if ads are added later, place a clearly labeled ad unit
      after user-content sections like the FAQ, never near Download, Fetch, Clear, or paste controls.
    */}

    <!-- Latest Articles -->
    <section class="mb-12 sm:mb-20 scroll-mt-14 sm:scroll-mt-24">
      <div class="rounded-xl bg-canvas border border-hairline px-5 sm:px-10 py-8 sm:py-12">
        <h2 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-0 mb-6 leading-tight text-balance">
          Latest Guides &amp; Articles
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {latestArticles.map((article) => (
            <a href={article.href} class="group flex flex-col overflow-hidden rounded-xl border border-hairline bg-canvas hover:border-link/30 transition-colors no-underline">
              <img src={article.image} alt={article.alt} class="aspect-[16/9] w-full object-cover border-b border-hairline" loading="lazy" width="836" height="471" />
              <div class="p-5">
                <h3 class="text-ink font-medium text-sm sm:text-base tracking-tight group-hover:text-link transition-colors">
                  {article.title}
                </h3>
                <p class="text-mute text-xs sm:text-sm mt-1.5 leading-relaxed">
                  {article.description}
                </p>
              </div>
            </a>
          ))}
        </div>

        <p class="mt-6 pt-4 border-t border-hairline text-center">
          <a href="/blog/" class="text-link underline underline-offset-2 decoration-link/30 hover:decoration-link transition-colors font-medium">View all articles &rarr;</a>
        </p>
      </div>
