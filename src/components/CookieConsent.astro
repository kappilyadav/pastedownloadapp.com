<div
  id="cookieConsent"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-hairline bg-canvas px-4 py-4 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] sm:px-6"
  role="region"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-[1400px] flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-body">
      We use cookies for analytics and to show ads through Google AdSense. Some cookies may be used by Google and its partners to personalize ads based on your visits to this and other sites. See our <a href="/cookie-policy/" class="text-link underline underline-offset-2 decoration-link/30 hover:decoration-link">Cookie Policy</a> and <a href="/privacy/" class="text-link underline underline-offset-2 decoration-link/30 hover:decoration-link">Privacy Policy</a> for details.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        id="cookieRejectBtn"
        class="text-body text-sm px-4 py-2 rounded-full border border-hairline hover:bg-canvas-soft transition-colors cursor-pointer bg-transparent focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none"
      >
        Reject non-essential
      </button>
      <button
        type="button"
        id="cookieAcceptBtn"
        class="bg-ink dark:bg-white text-on-primary dark:text-black text-sm font-medium px-4 sm:px-5 py-2 rounded-full hover:opacity-90 transition-opacity border-none cursor-pointer focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none"
      >
        Accept all
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var storageKey = 'cookie-consent';
    var banner = document.getElementById('cookieConsent');
    var acceptBtn = document.getElementById('cookieAcceptBtn');
    var rejectBtn = document.getElementById('cookieRejectBtn');

    function getStoredConsent() {
      try {
        return localStorage.getItem(storageKey);
      } catch (error) {
        return null;
      }
    }

    function storeConsent(value) {
      try {
        localStorage.setItem(storageKey, value);
      } catch (error) {}
    }

    function updateConsent(granted) {
      if (typeof window.gtag !== 'function') return;
      window.gtag('consent', 'update', {
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
        analytics_storage: granted ? 'granted' : 'denied'
      });
    }

    function hideBanner() {
      if (banner) banner.classList.add('hidden');
    }

    if (!banner) return;

    var existing = getStoredConsent();
    if (existing === 'granted') {
      updateConsent(true);
      hideBanner();
    } else if (existing === 'denied') {
      updateConsent(false);
      hideBanner();
    } else {
      banner.classList.remove('hidden');
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        storeConsent('granted');
        updateConsent(true);
        hideBanner();
      });
    }

    if (rejectBtn) {
      rejectBtn.addEventListener('click', function () {
        storeConsent('denied');
        updateConsent(false);
        hideBanner();
      });
    }
  })();
</script>
