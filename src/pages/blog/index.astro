---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { latestArticles } from '../../data/articles';
---

<ContentLayout title="Blog - PasteDownloadApp" description="Tips and guides for saving clipboard images, downloading screenshots, and using PasteDownloadApp." canonicalUrl="https://pastedownloadapp.com/blog/">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://pastedownloadapp.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://pastedownloadapp.com/blog/" }
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Blog - PasteDownloadApp",
      "description": "Tips and guides for saving clipboard images, downloading screenshots, and using PasteDownloadApp.",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "url": "https://pastedownloadapp.com/blog/png-vs-jpg-vs-webp/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "url": "https://pastedownloadapp.com/blog/download-copied-image-mac/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "url": "https://pastedownloadapp.com/blog/save-screenshot-as-file-windows/"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "url": "https://pastedownloadapp.com/blog/save-clipboard-image-without-software/"
          }
        ]
      }
    }
  </script>
  <h1 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-0 mb-6 leading-tight text-balance">
    Blog
  </h1>

  <div class="text-body text-sm sm:text-[15px] leading-relaxed space-y-4">
    <p>Tips and guides for saving images from your clipboard without extra software.</p>

    <div class="grid gap-4 mt-6">
      {latestArticles.map((article) => (
        <a href={article.href} class="group grid gap-4 sm:grid-cols-[180px_1fr] rounded-xl border border-hairline bg-canvas overflow-hidden no-underline transition-colors hover:border-hairline-strong focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none">
          <img
            src={article.image}
            alt={article.alt}
            width="836"
            height="471"
            loading="lazy"
            class="w-full sm:h-full aspect-[16/9] object-cover bg-canvas-soft"
          />
          <span class="block p-4 sm:pl-0">
            <span class="block text-ink text-base sm:text-lg font-semibold tracking-tight leading-snug group-hover:text-link transition-colors">{article.title}</span>
            <span class="block text-mute text-xs sm:text-sm leading-relaxed mt-2">{article.description}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</ContentLayout>
