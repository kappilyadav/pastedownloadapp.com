      </button>
      <a href="https://ko-fi.com/S2R1217QU6" target="_blank" rel="noopener noreferrer" class="ml-1.5">
        <img height="36" src="https://storage.ko-fi.com/cdn/kofi6.png?v=6" alt="Buy Me a Coffee at ko-fi.com" style="height:36px;border:0;" />
      </a>
    </nav>

    <!-- Mobile theme toggle (visible only on small screens) -->
    <button id="mobileThemeToggleBtn" class="sm:hidden w-7 h-7 relative rounded-full border border-hairline flex items-center justify-center text-body hover:text-ink transition-colors cursor-pointer bg-transparent focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none" aria-label="Toggle dark mode">
      <svg class="absolute opacity-100 dark:opacity-0" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
