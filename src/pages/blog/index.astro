---
import ContentLayout from '../../layouts/ContentLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { latestArticles } from '../../data/articles';
---

<ContentLayout wide title="Blog - PasteDownloadApp" description="Tips and guides for saving clipboard images, downloading screenshots, and using PasteDownloadApp." canonicalUrl="https://pastedownloadapp.com/blog/" breadcrumbs={[{ name: "Home", href: "/" }, { name: "Blog" }]}>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Blog - PasteDownloadApp",
      "description": "Tips and guides for saving clipboard images, downloading screenshots, and using PasteDownloadApp.",
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "url": "https://pastedownloadapp.com/blog/clipboard-paste-chrome-firefox-safari/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "url": "https://pastedownloadapp.com/blog/mobile-clipboard-android-vs-ios/"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "url": "https://pastedownloadapp.com/blog/access-clipboard-not-working/"
          },
          {
            "@type": "ListItem",
            "position": 4,
            "url": "https://pastedownloadapp.com/blog/convert-multiple-screenshots-fast/"
          },
          {
            "@type": "ListItem",
            "position": 5,
            "url": "https://pastedownloadapp.com/blog/image-compression-quality-settings/"
          },
          {
            "@type": "ListItem",
            "position": 6,
            "url": "https://pastedownloadapp.com/blog/svg-ico-conversion-quirks/"
          },
          {
            "@type": "ListItem",
            "position": 7,
            "url": "https://pastedownloadapp.com/blog/image-for-favicon-social-resume/"
          },
          {
            "@type": "ListItem",
            "position": 8,
            "url": "https://pastedownloadapp.com/blog/why-png-reencode-bigger/"
          },
          {
            "@type": "ListItem",
            "position": 9,
            "url": "https://pastedownloadapp.com/blog/png-vs-jpg-vs-webp/"
          },
          {
            "@type": "ListItem",
            "position": 10,
            "url": "https://pastedownloadapp.com/blog/download-copied-image-mac/"
          },
          {
            "@type": "ListItem",
            "position": 11,
            "url": "https://pastedownloadapp.com/blog/save-screenshot-as-file-windows/"
          },
          {
            "@type": "ListItem",
            "position": 12,
            "url": "https://pastedownloadapp.com/blog/save-clipboard-image-without-software/"
          },
          {
            "@type": "ListItem",
            "position": 13,
            "url": "https://pastedownloadapp.com/blog/where-do-clipboard-images-go/"
          },
          {
            "@type": "ListItem",
            "position": 14,
            "url": "https://pastedownloadapp.com/blog/paste-screenshot-into-email-attachment/"
          },
          {
            "@type": "ListItem",
            "position": 15,
            "url": "https://pastedownloadapp.com/blog/why-image-url-wont-download/"
          }
        ]
      }
    }
  </script>
  <h1 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-0 mb-6 leading-tight text-balance">
    Blog
  </h1>

  <div class="text-body text-base sm:text-[17px] leading-relaxed space-y-4">
    <p>Tips and guides for saving images from your clipboard without extra software.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
      {latestArticles.map((article) => (
        <ArticleCard href={article.href} image={article.image} alt={article.alt} title={article.title} description={article.description} />
      ))}
    </div>
  </div>
</ContentLayout>
