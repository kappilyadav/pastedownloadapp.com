<header class="sticky top-0 z-50 bg-canvas/80 backdrop-blur-md border-b border-hairline">
  <div class="mx-auto max-w-[1400px] flex items-center justify-between h-14 sm:h-16 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 no-underline shrink-0">
