---
export interface Props {
  publishDate: string;
  updatedDate?: string;
}

const { publishDate, updatedDate } = Astro.props;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<div class="not-prose mb-6 rounded-xl border border-hairline border-l-4 border-l-link bg-canvas-soft p-4 sm:p-5">
  <div class="flex items-center gap-3.5">
    <a href="/author/" class="shrink-0 rounded-full focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none" aria-label="Kappil Yadav, author profile">
      <img
        src="/author-kappil-yadav.webp"
        alt="Kappil Yadav"
        width="56"
        height="56"
        loading="lazy"
        decoding="async"
        class="w-12 h-12 sm:w-14 sm:h-14 rounded-full border-2 border-canvas ring-1 ring-hairline object-cover bg-canvas"
      />
    </a>
    <div class="flex flex-col leading-tight min-w-0">
      <span class="text-sm sm:text-base text-body">Written by <a href="/author/" class="font-semibold text-ink no-underline hover:text-link transition-colors">Kappil Yadav</a></span>
      <span class="text-xs sm:text-sm text-mute mt-1">Full-Stack Developer, PasteDownloadApp</span>
    </div>
  </div>
  <div class="flex flex-wrap gap-2 mt-3.5 text-xs font-medium">
    <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3 py-1 text-body">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Published {formatDate(publishDate)}
    </span>
    {updatedDate && (
      <span class="inline-flex items-center gap-1.5 rounded-full border border-hairline bg-canvas px-3 py-1 text-body">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        Updated {formatDate(updatedDate)}
      </span>
    )}
  </div>
</div>
