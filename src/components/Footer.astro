---
import SocialLinks from './SocialLinks.astro';
import { useTranslations } from '../i18n/index';
import { homePath, type Locale } from '../i18n/locales';

export interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).footer;
const home = homePath(locale ?? 'en');
---

<footer class="w-full border-t border-hairline">
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 py-8 sm:py-12">
    <div class="flex flex-col md:flex-row items-start justify-between gap-10">
      <div class="max-w-[260px]">
        <a href={home} class="flex items-center gap-2.5 no-underline">
          <img src="/logo.svg" alt={t.logoAlt} width="32" height="32" class="w-7 h-7 rounded-md dark:ring-1 dark:ring-hairline-strong" loading="lazy" decoding="async" />
          <span class="text-sm font-semibold text-ink tracking-tight">Paste Download</span>
        </a>
        <p class="text-body text-xs mt-3 leading-relaxed text-pretty">
          {t.tagline}
        </p>
        <SocialLinks class="mt-4" />
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-10">
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">{t.product}</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href={`${home}#paste`} class="text-body text-sm no-underline hover:text-ink transition-colors">{t.paste}</a></li>
            <li><a href={`${home}#features`} class="text-body text-sm no-underline hover:text-ink transition-colors">{t.features}</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">{t.company}</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href="/about/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.about}</a></li>
            <li><a href="/blog/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.blog}</a></li>
            <li><a href="/author/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.author}</a></li>
            <li><a href="/categories/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.categories}</a></li>
            <li><a href="/contact/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.contact}</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">{t.legal}</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href="/privacy/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.privacy}</a></li>
            <li><a href="/cookie-policy/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.cookies}</a></li>
            <li><a href="/terms/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.terms}</a></li>
            <li><a href="/disclaimer/" class="text-body text-sm no-underline hover:text-ink transition-colors">{t.disclaimer}</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4">
      <p class="text-mute text-xs text-center m-0">&copy; {new Date().getFullYear()} pastedownloadapp.com. {t.rights}</p>
      <a href="/sitemap/" class="text-mute text-xs no-underline hover:text-ink transition-colors">{t.sitemap}</a>
    </div>
  </div>
</footer>
