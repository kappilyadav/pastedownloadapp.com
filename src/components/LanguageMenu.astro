---
import { useTranslations } from '../i18n/index';
import { locales, localeInfo, homePath, type Locale } from '../i18n/locales';

export interface Props {
  locale?: Locale;
  class?: string;
}

const { locale = 'en', class: className = '' } = Astro.props;
const t = useTranslations(locale).languages;
---

<div class:list={['relative', className]} data-lang-menu>
  <button type="button" data-lang-trigger class="h-10 sm:h-7 px-2.5 gap-1.5 rounded-full border border-hairline flex items-center justify-center text-body hover:text-ink transition-colors cursor-pointer bg-transparent text-xs focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none" aria-label={t.label} aria-haspopup="menu" aria-expanded="false">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
    <span class="uppercase">{locale}</span>
  </button>
  <div data-lang-dropdown class="hidden absolute right-0 top-full z-50 mt-2 min-w-36 rounded-md border border-hairline bg-canvas p-1 text-ink shadow-[0_8px_24px_-8px_#00000040,0_2px_8px_#00000014]">
    {locales.map((l) => (
      <a
        href={homePath(l)}
        lang={localeInfo[l].hreflang}
        hreflang={localeInfo[l].hreflang}
        aria-current={l === locale ? 'true' : undefined}
        class:list={[
          'flex items-center justify-between gap-3 rounded-sm px-3 py-1.5 text-sm no-underline transition-colors hover:bg-canvas-soft-2 hover:text-ink focus-visible:bg-canvas-soft-2 focus-visible:outline-none',
          l === locale ? 'text-ink bg-canvas-soft-2 font-medium' : 'text-body'
        ]}
      >
        {localeInfo[l].name}
        {l === locale && <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>}
      </a>
    ))}
  </div>
</div>

<script>
  function closeLangMenus() {
    document.querySelectorAll('[data-lang-menu]').forEach((menu) => {
      menu.querySelector('[data-lang-trigger]')?.setAttribute('aria-expanded', 'false');
      menu.querySelector('[data-lang-dropdown]')?.classList.add('hidden');
    });
  }

  document.querySelectorAll('[data-lang-menu]').forEach((menu) => {
    const trigger = menu.querySelector('[data-lang-trigger]')!;
    const dropdown = menu.querySelector('[data-lang-dropdown]')!;
    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      document.dispatchEvent(new CustomEvent('pdl:close-menus'));
      closeLangMenus();
      if (!isOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        dropdown.classList.remove('hidden');
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-lang-menu]')) closeLangMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeLangMenus();
  });

  document.addEventListener('pdl:close-menus', closeLangMenus);
</script>
