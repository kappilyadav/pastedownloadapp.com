---
import { latestArticles } from '../data/articles';

export interface Props {
  hrefs: string[];
}

const { hrefs } = Astro.props;
const relatedArticles = hrefs
  .map((href) => latestArticles.find((article) => article.href === href))
  .filter((article) => article !== undefined);
---

<section class="mt-10 pt-6 border-t border-hairline">
  <h2 class="text-ink text-lg sm:text-xl font-semibold tracking-tight mt-0 mb-2 leading-tight">Related Guides</h2>
  <div class="grid gap-4 mt-4">
    {relatedArticles.map((article) => (
      <a href={article.href} class="group grid gap-4 sm:grid-cols-[160px_1fr] rounded-xl border border-hairline bg-canvas overflow-hidden !no-underline transition-colors hover:border-hairline-strong focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none">
        <img
          src={article.image}
          alt={article.alt}
          width="836"
          height="471"
          loading="lazy"
          class="w-full sm:h-full aspect-[16/9] object-cover bg-canvas-soft"
        />
        <span class="block p-4 sm:pl-0">
          <span class="block text-ink text-base font-semibold tracking-tight leading-snug !no-underline group-hover:text-link transition-colors">{article.title}</span>
          <span class="block text-mute text-xs sm:text-sm leading-relaxed mt-2 !no-underline">{article.description}</span>
        </span>
      </a>
    ))}
  </div>
</section>
