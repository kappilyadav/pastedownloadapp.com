---
const steps = [
  {
    step: '01',
    title: 'Copy an Image',
    description: 'Copy any image from your computer, browser, or screenshot tool using Ctrl+C (or \u2318+C on Mac) to begin your paste image to download workflow.'
  },
  {
    step: '02',
    title: 'Paste or Enter URL',
    description: 'Press Ctrl+V (\u2318+V) in the paste zone to paste download image from clipboard, or enter an image URL for instant fetching.'
  },
  {
    step: '03',
    title: 'Choose Format & Download',
    description: 'Select PNG, JPEG, or WebP and click download to complete your copy paste download. Enable auto-download for one-click saving.'
  }
];
---

<section id="how-it-works" class="w-full">
  <div class="rounded-xl bg-ink dark:bg-black text-on-primary px-5 sm:px-14 py-10 sm:py-16 dark:border dark:border-hairline">
    <div class="text-center mb-8 sm:mb-12">
      <p class="text-white/40 text-xs font-medium uppercase tracking-widest m-0">How It Works</p>
      <h2 class="text-xl sm:text-2xl lg:text-[32px] font-semibold tracking-tight mt-3 mb-4 leading-tight text-balance">
        Three simple steps
      </h2>
      <p class="text-white/60 text-sm sm:text-[17px] max-w-[460px] mx-auto leading-relaxed text-pretty">
        No sign-up, no uploads, no fuss. Just copy, paste, and download.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 md:gap-12">
      {steps.map((item) => (
        <div class="text-center">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-4 sm:mb-5 text-white/60 text-xs sm:text-sm font-mono font-medium" aria-hidden="true">
            {item.step}
          </div>
          <h3 class="text-base sm:text-lg font-semibold tracking-tight m-0">{item.title}</h3>
          <p class="text-white/50 text-xs sm:text-sm mt-2 leading-relaxed m-0 max-w-[300px] mx-auto text-pretty">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
