---
export interface Props {
  href: string;
  image: string;
  alt: string;
  title: string;
  description: string;
}

const { href, image, alt, title, description } = Astro.props;
---

<a href={href} class="group flex flex-col rounded-xl border border-hairline bg-canvas overflow-hidden no-underline transition-colors hover:border-hairline-strong focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none">
  <img
    src={image}
    alt={alt}
    width="836"
    height="471"
    loading="lazy"
    decoding="async"
    class="w-full aspect-[16/9] object-cover bg-canvas-soft border-b border-hairline"
  />
  <span class="flex flex-col flex-1 p-4 sm:p-5">
    <span class="block text-ink text-base font-semibold tracking-tight leading-snug group-hover:text-link transition-colors">{title}</span>
    <span class="block text-mute text-xs sm:text-sm leading-relaxed mt-2 line-clamp-3">{description}</span>
  </span>
</a>
