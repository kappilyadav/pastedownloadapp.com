---
const features = [
  {
    title: 'Paste from Clipboard',
    description: 'Use Ctrl+V or Cmd+V to turn copied screenshots, photos, and graphics into downloadable files.',
    icon: 'clipboard'
  },
  {
    title: 'Format Conversion',
    description: 'Convert pasted images between PNG, JPEG, and WebP before saving them to your device.',
    icon: 'convert'
  },
  {
    title: 'Privacy First',
    description: 'Clipboard images are processed locally in your browser, so private files stay on your device.',
    icon: 'shield'
  },
  {
    title: 'Auto Download',
    description: 'Enable auto-download to save each pasted image immediately. Ideal for quick batches.',
    icon: 'batch'
  },
  {
    title: 'Drag & Drop',
    description: 'Drag image files into the paste zone for an instant preview and download options.',
    icon: 'dragdrop'
  }
];
---

<section id="features" class="w-full">
  <div class="text-center mb-12">
    <p class="text-mute text-xs font-medium uppercase tracking-widest m-0">Features</p>
    <h2 class="text-xl sm:text-2xl lg:text-[32px] font-semibold text-ink tracking-tight mt-3 mb-4 leading-tight text-balance">
      Why use PasteDownload for instant image downloads
    </h2>
    <p class="text-body text-sm sm:text-[17px] max-w-[520px] mx-auto leading-relaxed text-pretty">
      Save clipboard images and convert formats: all in your browser, nothing leaves your device.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {
      features.map((feature) => {
        const Icon = feature.icon;
        return (
          <div class="rounded-lg bg-canvas border border-hairline p-5 sm:p-6 shadow-[0px_1px_1px_#00000005,0px_2px_2px_#0000000a] hover:shadow-[0px_2px_2px_#0000000a,0px_8px_8px_-8px_#0000000a] transition-shadow duration-200">
            <div class="w-10 h-10 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center text-body mb-4" aria-hidden="true">
              {
                Icon === 'clipboard' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
              }
              {
                Icon === 'convert' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/></svg>
              }
              {
                Icon === 'shield' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              }
              {
                Icon === 'batch' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              }
              {
                Icon === 'dragdrop' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              }
            </div>
            <h3 class="text-base font-semibold text-ink tracking-tight m-0">{feature.title}</h3>
            <p class="text-body text-sm mt-2 leading-relaxed m-0 text-pretty">{feature.description}</p>
          </div>
        );
      })
    }
  </div>
</section>
