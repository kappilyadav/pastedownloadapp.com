                        <th class="px-4 py-3 font-semibold">Change</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                    <tr>
                        <td class="px-4 py-3 font-semibold text-ink">Gradient illustration, 1672&times;941</td>
