---
import '../styles/global.css';
import ConsentDefault from '../components/ConsentDefault.astro';
import AdSense from '../components/AdSense.astro';
import ThemeScript from '../components/ThemeScript.astro';
import Analytics from '../components/Analytics.astro';
import InstallPrompt from '../components/InstallPrompt.astro';
import { localeInfo, defaultLocale, type Locale } from '../i18n/locales';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  keywords?: string;
  noAds?: boolean;
  noindex?: boolean;
  locale?: Locale;
  alternates?: { hreflang: string; href: string }[];
}

const { title, description, canonicalUrl, keywords, noAds = false, noindex = false, locale = defaultLocale, alternates = [] } = Astro.props;
---

<!doctype html>
<html lang={localeInfo[locale].hreflang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafa" />
    <ConsentDefault />
    {!noAds && <AdSense />}
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    </noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="max-image-preview:large, max-snippet:-1" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site overview" />

    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="PasteDownloadApp" />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {alternates.filter((alt) => alt.hreflang !== 'x-default' && alt.hreflang !== localeInfo[locale].hreflang).map((alt) => <meta property="og:locale:alternate" content={Object.values(localeInfo).find((i) => i.hreflang === alt.hreflang)?.ogLocale} />)}
    <meta property="og:image" content="https://pastedownloadapp.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://pastedownloadapp.com/og-image.png" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://pastedownloadapp.com/#organization",
        "name": "PasteDownloadApp",
        "alternateName": ["PasteDownload", "Paste Download"],
        "url": "https://pastedownloadapp.com/",
        "logo": "https://pastedownloadapp.com/favicon.svg",
        "foundingDate": "2026",
        "founder": {
            "@type": "Person",
            "@id": "https://pastedownloadapp.com/author/#person",
            "name": "Kappil Yadav",
            "url": "https://pastedownloadapp.com/author/",
            "image": "https://pastedownloadapp.com/author-kappil-yadav.webp",
            "jobTitle": "Founder & Developer",
            "description": "Full-stack developer who builds and maintains PasteDownloadApp using the browser's native Clipboard and Canvas APIs. Ships public code on GitHub and tests every guide against real files in the live tool before publishing.",
            "email": "hello@pastedownloadapp.com",
            "knowsAbout": [
                "Clipboard API",
                "Canvas API",
                "Image formats",
                "Web development"
            ],
            "sameAs": [
                "https://github.com/kappilyadav",
                "https://www.linkedin.com/in/kapilyadavv",
                "https://www.instagram.com/heykapil_"
            ],
            "worksFor": {
                "@type": "Organization",
                "@id": "https://pastedownloadapp.com/#organization",
                "name": "PasteDownloadApp",
                "url": "https://pastedownloadapp.com/"
            }
        },
        "sameAs": ["https://github.com/kappilyadav/pastedownloadapp.com", "https://www.producthunt.com/products/pastedownloadapp"],
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "hello@pastedownloadapp.com"
        }
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://pastedownloadapp.com/#website",
        "name": "PasteDownload",
        "alternateName": ["PasteDownloadApp", "Paste Download"],
        "url": "https://pastedownloadapp.com/",
        "description": "Free online tool to save clipboard images or direct image URLs as downloadable files.",
        "publisher": { "@id": "https://pastedownloadapp.com/#organization" }
      }
    </script>
    {/* <link rel="preconnect" href="https://storage.ko-fi.com" /> */}
    <Analytics />
  </head>
  <body class="min-h-screen">
    <slot />
    <InstallPrompt />

    {/*
    <script is:inline>
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.src = 'https://storage.ko-fi.com/cdn/scripts/overlay-widget.js';
        s.onload = function() {
          kofiWidgetOverlay.draw('kappilyadav', {
            'type': 'floating-chat',
            'floating-chat.donateButton.text': 'Support me',
            'floating-chat.donateButton.background-color': '#f45d22',
            'floating-chat.donateButton.text-color': '#fff'
          });
        };
        document.body.appendChild(s);
      });
    </script>
    <style>
      iframe[title*="Ko-Fi"] {
        right: auto !important;
        left: 50% !important;
        transform: translateX(-50%) !important;
      }
    </style>
    */}
  </body>
</html>
