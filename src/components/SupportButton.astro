---
import { useTranslations } from '../i18n/index';
import type { Locale } from '../i18n/locales';

export interface Props {
  locale?: Locale;
  location: string;
  size?: 'sm' | 'md' | 'lg';
  iconOnly?: boolean;
  class?: string;
}

const { locale, location, size = 'md', iconOnly = false, class: className = '' } = Astro.props;
const t = useTranslations(locale).support;

const sizes = {
  sm: 'text-xs px-3.5 py-1.5 gap-1.5',
  md: 'text-sm px-5 py-2.5 gap-2',
  lg: 'text-[15px] px-7 py-3 gap-2'
};
const iconSizes = { sm: 14, md: 16, lg: 20 };
const iconSize = iconSizes[size];
---

<a
  href="https://ko-fi.com/kappilyadav"
  target="_blank"
  rel="noopener noreferrer"
  data-support-location={location}
  aria-label={iconOnly ? t.button : undefined}
  class:list={[
    'inline-flex items-center justify-center rounded-full bg-[#dc2626] hover:bg-[#b91c1c] text-white font-bold no-underline whitespace-nowrap transition-colors focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none',
    iconOnly ? 'w-10 h-10 p-0' : sizes[size],
    className
  ]}
>
  <svg width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
  {!iconOnly && <span>{t.button}</span>}
</a>

<script>
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLElement>('[data-support-location]');
    if (!link) return;
    const w = window as unknown as { gtag?: (...args: unknown[]) => void };
    w.gtag?.('event', 'support_click', { location: link.dataset.supportLocation });
  });
</script>
