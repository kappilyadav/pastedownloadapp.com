---
import { useTranslations } from '../i18n/index';
import type { Locale } from '../i18n/locales';

export interface Props {
  locale?: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale).stats;
const emojis = ['📋', '🚀', '⚡', '🔥', '🦸', '👑', '🏆'];
const thresholds = [0, 1, 5, 10, 25, 50, 100];
const levels = t.levels.map((name, index) => ({ at: thresholds[index], emoji: emojis[index], name }));
const config = JSON.stringify({
  levels,
  unitOne: t.unitOne,
  unitMany: t.unitMany,
  firstPrompt: t.firstPrompt,
  next: t.next,
  top: t.top
});
---

<div id="heroStats" data-config={config} class="mx-auto mb-6 w-full max-w-xs rounded-2xl border border-hairline bg-canvas px-4 py-3 text-left" aria-live="polite">
  <div class="flex items-center gap-3">
    <span id="heroStatsEmoji" class="text-3xl leading-none select-none" aria-hidden="true">📋</span>
    <div class="flex-1 min-w-0">
      <p class="m-0 text-ink text-sm font-semibold leading-tight"><span id="heroStatsCount" class="tabular-nums text-xl">0</span> <span id="heroStatsUnit">{t.unitMany}</span></p>
      <p id="heroStatsLevel" class="m-0 mt-0.5 text-mute text-xs leading-tight">{t.levels[0]}</p>
    </div>
  </div>
  <div class="mt-3 h-1.5 w-full rounded-full bg-canvas-soft-2 overflow-hidden" role="progressbar" aria-label={t.progressLabel} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="heroStatsBarWrap">
    <div id="heroStatsBar" class="h-full rounded-full bg-gradient-to-r from-[#007cf0] via-[#7928ca] to-[#ff0080] transition-[width] duration-700 ease-out" style="width:0%"></div>
  </div>
  <p id="heroStatsNext" class="m-0 mt-1.5 text-mute text-xs">{t.firstPrompt}</p>
</div>

<script>
  const card = document.getElementById('heroStats')!;
  const cfg = JSON.parse(card.dataset.config || '{}') as {
    levels: { at: number; emoji: string; name: string }[];
    unitOne: string;
    unitMany: string;
    firstPrompt: string;
    next: string;
    top: string;
  };
  const LEVELS = cfg.levels;
  const $ = (id: string) => document.getElementById(id);
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let shown = 0;
  let raf = 0;

  function render(n: number) {
    let i = 0;
    while (i + 1 < LEVELS.length && n >= LEVELS[i + 1].at) i++;
    const cur = LEVELS[i];
    const next = LEVELS[i + 1];
    $('heroStatsEmoji')!.textContent = cur.emoji;
    $('heroStatsLevel')!.textContent = cur.name;
    $('heroStatsUnit')!.textContent = n === 1 ? cfg.unitOne : cfg.unitMany;
    const pct = next ? Math.round(((n - cur.at) / (next.at - cur.at)) * 100) : 100;
    $('heroStatsBar')!.style.width = pct + '%';
    $('heroStatsBarWrap')!.setAttribute('aria-valuenow', String(pct));
    $('heroStatsNext')!.textContent = !next
      ? cfg.top
      : n === 0
        ? cfg.firstPrompt
        : cfg.next.replace('{n}', String(next.at - n)).replace('{emoji}', next.emoji).replace('{name}', next.name);
  }

  function setCount(n: number, animate: boolean) {
    cancelAnimationFrame(raf);
    const from = shown;
    shown = n;
    render(n);
    const el = $('heroStatsCount')!;
    if (!animate || reduceMotion || from === n) { el.textContent = String(n); return; }
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / 600);
      el.textContent = String(Math.round(from + (n - from) * t));
      if (t < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
    card.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.05)' }, { transform: 'scale(1)' }], { duration: 400 });
  }

  let initial = 0;
  try { initial = parseInt(localStorage.getItem('pdl:download-count') || '0', 10) || 0; } catch {}
  setCount(initial, initial > 0);
  document.addEventListener('pdl:count', (e) => setCount((e as CustomEvent<number>).detail, true));
</script>
