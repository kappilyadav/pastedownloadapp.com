---
const cases = [
  {
    title: 'Screenshot for a report or email',
    image: '/home/use-screenshot.webp',
    alt: 'A 1600 by 900 sales dashboard screenshot used as the test image',
    detail: '1600×900 dashboard screenshot',
    sizes: { png: '139.0 KB', jpeg: '83.8 KB', webp: '40.7 KB' },
    pick: 'WebP',
    tip: 'WebP was 71% smaller than PNG. If the person opening it uses an older app, choose JPEG instead.',
    href: '/blog/paste-screenshot-into-email-attachment/',
    linkText: 'Turn a pasted screenshot into an email attachment'
  },
  {
    title: 'Full-screen capture for a document',
    image: '/home/use-large-screenshot.webp',
    alt: 'The same dashboard captured at 2560 by 1440',
    detail: '2560×1440 full-screen capture',
    sizes: { png: '266.1 KB', jpeg: '156.2 KB', webp: '72.4 KB' },
    pick: 'WebP',
    tip: 'A bigger capture saves more in absolute terms: 193.7 KB less than PNG, without changing how it looks on screen.',
    href: '/blog/png-vs-jpg-vs-webp/',
    linkText: 'PNG vs JPG vs WebP in detail'
  },
  {
    title: 'Signature to place in a PDF',
    image: '/home/use-signature.webp',
    alt: 'A dark blue signature on a light background, the 1200 by 500 test image',
    detail: '1200×500 signature, transparent background',
    sizes: { png: '47.6 KB', jpeg: '29.5 KB', webp: '18.4 KB' },
    pick: 'PNG',
    tip: 'PNG and WebP keep the transparent background. JPEG fills it with white, which shows as a box on a coloured page.',
    href: '/blog/paste-image-into-pdf/',
    linkText: 'How to paste an image into a PDF'
  },
  {
    title: 'Icon or logo for a website',
    image: '/home/use-icon.webp',
    alt: 'A 512 by 512 rounded app icon with a gradient background, the test image',
    detail: '512×512 icon, rounded transparent corners',
    sizes: { png: '259.0 KB', jpeg: '20.4 KB', webp: '10.3 KB' },
    pick: 'WebP',
    tip: 'Use PNG when a platform insists on it, such as a favicon source. Otherwise WebP is the smallest and keeps the rounded corners clean.',
    href: '/blog/image-for-favicon-social-resume/',
    linkText: 'Images for favicons, social cards, and resumes'
  }
];
---

<section id="real-life-uses" class="w-full">
  <div class="rounded-xl bg-canvas border border-hairline px-5 sm:px-10 py-8 sm:py-12">
    <p class="text-mute text-xs font-medium uppercase tracking-widest m-0">Real examples</p>
    <h2 class="text-xl sm:text-2xl lg:text-[28px] font-semibold text-ink tracking-tight mt-3 mb-2 leading-tight">
      What you get for common jobs
    </h2>
    <p class="text-body text-base sm:text-[17px] leading-relaxed mt-0 mb-8 max-w-3xl">
      We pasted four test images into the tool and wrote down the file size it produced for each format. These are real results at the default quality, not estimates.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {cases.map((item) => (
        <article class="flex flex-col overflow-hidden rounded-xl border border-hairline bg-canvas">
          <div class="bg-canvas-soft border-b border-hairline flex items-center justify-center h-44 sm:h-48">
            <img src={item.image} alt={item.alt} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" width="640" height="360" />
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="text-ink text-base sm:text-lg font-semibold tracking-tight m-0 leading-tight">{item.title}</h3>
            <p class="text-mute text-xs sm:text-sm mt-1 mb-4">{item.detail}</p>

            <dl class="grid grid-cols-3 gap-1.5 sm:gap-2 m-0 mb-4 text-center">
              {[['PNG', item.sizes.png], ['JPEG', item.sizes.jpeg], ['WebP', item.sizes.webp]].map(([label, size]) => (
                <div class={`rounded-lg border px-1.5 sm:px-2 py-2 ${label === item.pick ? 'border-link/40 bg-link-bg-soft/30' : 'border-hairline bg-canvas-soft'}`}>
                  <dt class="text-mute text-[11px] font-medium uppercase tracking-wide">{label}</dt>
                  <dd class="text-ink text-[13px] sm:text-sm font-semibold m-0 mt-0.5 whitespace-nowrap">{size}</dd>
                </div>
              ))}
            </dl>

            <p class="text-body text-sm sm:text-base leading-relaxed m-0"><strong class="text-ink">Best pick: {item.pick}.</strong> {item.tip}</p>
            <p class="mt-auto pt-4 mb-0"><a href={item.href} class="text-link text-sm underline underline-offset-2 decoration-link/30 hover:decoration-link transition-colors">{item.linkText}</a></p>
          </div>
        </article>
      ))}
    </div>

    <p class="text-mute text-xs sm:text-sm leading-relaxed mt-6 mb-0">
      Test images are generated flat-colour graphics, which is what most screenshots, logos, and signatures are. Photos behave differently: JPEG and WebP usually save far more on a photo than they do here.
    </p>
  </div>
</section>
