---
import SocialLinks from './SocialLinks.astro';
---

<footer class="w-full border-t border-hairline">
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 py-8 sm:py-12">
    <div class="flex flex-col md:flex-row items-start justify-between gap-10">
      <div class="max-w-[260px]">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <img src="/logo.svg" alt="PasteDownloadApp logo" width="32" height="32" class="w-7 h-7 rounded-md dark:ring-1 dark:ring-hairline-strong" loading="lazy" decoding="async" />
          <span class="text-sm font-semibold text-ink tracking-tight">Paste Download</span>
        </a>
        <p class="text-body text-xs mt-3 leading-relaxed text-pretty">
          Paste photos from your clipboard and download instantly. All processing happens in your browser: nothing is uploaded.
        </p>
        <SocialLinks class="mt-4" />
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-10">
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">Product</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href="/#paste" class="text-body text-sm no-underline hover:text-ink transition-colors">Paste</a></li>
            <li><a href="/#features" class="text-body text-sm no-underline hover:text-ink transition-colors">Features</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">Company</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href="/about/" class="text-body text-sm no-underline hover:text-ink transition-colors">About</a></li>
            <li><a href="/blog/" class="text-body text-sm no-underline hover:text-ink transition-colors">Blog</a></li>
            <li><a href="/author/" class="text-body text-sm no-underline hover:text-ink transition-colors">Author</a></li>
            <li><a href="/categories/" class="text-body text-sm no-underline hover:text-ink transition-colors">Categories</a></li>
            <li><a href="/contact/" class="text-body text-sm no-underline hover:text-ink transition-colors">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-mute text-xs font-medium uppercase tracking-widest m-0 mb-3">Legal</h4>
          <ul class="list-none p-0 m-0 space-y-2">
            <li><a href="/privacy/" class="text-body text-sm no-underline hover:text-ink transition-colors">Privacy Policy</a></li>
            <li><a href="/cookie-policy/" class="text-body text-sm no-underline hover:text-ink transition-colors">Cookie Policy</a></li>
            <li><a href="/terms/" class="text-body text-sm no-underline hover:text-ink transition-colors">Terms &amp; Conditions</a></li>
            <li><a href="/disclaimer/" class="text-body text-sm no-underline hover:text-ink transition-colors">Disclaimer</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-hairline flex justify-center">
      <a href="https://findly.tools/paste-downloadapp-app?utm_source=paste-downloadapp-app" target="_blank" rel="noopener noreferrer" class="rounded-md focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none">
        <img src="https://findly.tools/badges/findly-tools-badge-light.svg" alt="Featured on Findly.tools" width="175" height="55" loading="lazy" decoding="async" />
      </a>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4">
      <p class="text-mute text-xs text-center m-0">&copy; {new Date().getFullYear()} pastedownloadapp.com. All rights reserved.</p>
      <a href="/sitemap/" class="text-mute text-xs no-underline hover:text-ink transition-colors">Sitemap</a>
    </div>
  </div>
</footer>
