---
import { author } from '../data/author.ts';
---

<aside class="not-prose mt-6 rounded-xl border border-hairline bg-canvas p-5 sm:p-6" aria-label="About the author">
  <div class="flex flex-col sm:flex-row gap-4 sm:gap-5">
    <a href="/author/" class="shrink-0 self-start rounded-full focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none" aria-label="Kappil Yadav, author profile">
      <img
        src="/author-kappil-yadav.webp"
        alt="Kappil Yadav"
        width="80"
        height="80"
        loading="lazy"
        decoding="async"
        class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-canvas ring-1 ring-hairline object-cover bg-canvas"
      />
    </a>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <a href="/author/" class="text-lg sm:text-xl font-semibold text-ink tracking-tight no-underline hover:text-link transition-colors">Kappil Yadav</a>
        <span class="rounded-full border border-hairline bg-link-bg-soft/40 px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-link">{author.jobTitle}</span>
      </div>
      <p class="text-body text-sm sm:text-base leading-relaxed mt-2 mb-0">
        {author.description}
      </p>
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mt-4 pt-4 border-t border-dashed border-hairline text-sm">
        <a href={`mailto:${author.email}`} class="inline-flex items-center gap-2 text-body no-underline hover:text-link transition-colors focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none rounded-md">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          {author.email}
        </a>
        <span class="flex items-center gap-2 font-semibold">
          <a href="/about/" class="text-link no-underline hover:underline focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none rounded-md">About Us</a>
          <span class="text-hairline-strong" aria-hidden="true">&middot;</span>
          <a href="/contact/" class="text-link no-underline hover:underline focus-visible:ring-2 focus-visible:ring-link focus-visible:outline-none rounded-md">Contact</a>
        </span>
      </div>
    </div>
  </div>
</aside>
